{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "bengali-book-ai-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bengali-book-ai-db",
      "database_id": "28b0c1ea-56ef-4b33-913d-971badceade6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "APP_ENV": "production", "BOOK_STORAGE": "github-releases" }
}
